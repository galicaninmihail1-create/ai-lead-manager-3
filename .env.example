APP_ENV=local
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://ai_lead_manager:local_dev_password@postgres:5432/ai_lead_manager
POSTGRES_DB=ai_lead_manager
POSTGRES_USER=ai_lead_manager
POSTGRES_PASSWORD=local_dev_password
AI_EXECUTION_MODE=MOCK
ALLOW_LIVE_AI=false
AI_KILL_SWITCH=false
AI_DEFAULT_QUALIFICATION_PROVIDER=mock
AI_DEFAULT_QUALIFICATION_MODEL=deterministic-keyword-v1
AI_DEFAULT_DRAFT_PROVIDER=mock
AI_DEFAULT_DRAFT_MODEL=deterministic-template-v1
AI_CONNECT_TIMEOUT_SECONDS=3
AI_READ_TIMEOUT_SECONDS=15
AI_TOTAL_TIMEOUT_SECONDS=20
AI_MAX_ATTEMPTS=2
AI_MAX_MESSAGES=20
AI_MAX_INPUT_CHARS=20000
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=1000
AI_OPENAI_COMPATIBLE_PROVIDERS_JSON=[]
AI_MODEL_PRICING_JSON=[]
POLZA_AI_API_KEY=
TENANT_API_KEY_PEPPER=
